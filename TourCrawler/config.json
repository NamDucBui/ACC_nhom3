{
	"Url": "https://www.bestprice.vn/tour",
	"ContainerSelector": ".tour-list",
	"ItemSelector": ".inner-box",
	"Fields": {
		"ImageUrl": ".col-img img",
		"Name": ".item-name",
		"SlugUrl": ".item-name",
		"Route": ".route",
		"Duration": ".block-duration",
		"PriceOriginal": ".mktnd_txt_publicl_price",
		"PricePromotion": ".mktnd_txt_sale_price",
		"RatingScore": ".mktnd_txt_score_review",
		"RatingCount": ".mktnd_txt_total_review strong",
		"HighlightReview": ".review_text .mktnd_txt_quotation_review span:first-child",
		"ReviewerName": ".review_text .mktnd_txt_quotation_review span:nth-child(2) span",
		"Tag": ".icon-sell",
		"EarlyPromotion": ".pro-offer-note.text-special",
		"GiftPromotion": ".pro-offer-note.text-promotion-free"
	},
	"LoadMoreButtonSelector": ".btn-more-tour",
	"MaxLoadMore": 3,
	"BackendApi": "http://localhost:5000/api/Tour"
}
